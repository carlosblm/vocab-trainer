# Copiar a .env y ajustar. .env nunca se commitea.
POSTGRES_USER=vocab
POSTGRES_PASSWORD=vocab
POSTGRES_DB=vocab

# Conexión desde el host (bucle de desarrollo con .venv).
# Dentro del contenedor, compose la sobrescribe apuntando a `db`.
DATABASE_URL=postgresql+psycopg://vocab:vocab@localhost:5432/vocab

LOG_LEVEL=INFO

# Directorio con los vocab.db reales, que nunca se commitean. Lo leen los tests
# que los necesitan (se saltan si falta) y compose, que lo monta en /data.
# Compose no expande `~`: ruta absoluta o relativa a la raíz del repositorio.
# Sin definir, compose monta el fixture versionado.
VOCAB_TEST_DATA=/home/carlo/vocab-data
