# Copiar a .env y ajustar. .env nunca se commitea.
POSTGRES_USER=vocab
POSTGRES_PASSWORD=vocab
POSTGRES_DB=vocab

# Conexión desde el host (bucle de desarrollo con .venv).
# Dentro del contenedor, compose la sobrescribe apuntando a `db`.
DATABASE_URL=postgresql+psycopg://vocab:vocab@localhost:5432/vocab

LOG_LEVEL=INFO

# Directorio con los vocab.db reales, que nunca se commitean. Lo leen los tests
# que los necesitan (se saltan si falta) y compose, que lo monta en /data.
# Compose no expande `~`: ruta absoluta o relativa a la raíz del repositorio.
# Sin definir, compose monta el fixture versionado.
VOCAB_TEST_DATA=/home/carlo/vocab-data

# Directorio de datos de `wn` (Open English WordNet). Lo exige
# scripts/measure_definition_source.py; es el nombre que lee la propia `wn`.
WN_DATA_DIR=~/wn-data

# Generación de distractores (A1). Proveedor, modelo y prompt son configuración
# de la tarea, no del código (§3.3.4, D-007). En F1 el único proveedor es ollama.
LLM_TASK__DISTRACTORS__PROVIDER=ollama
LLM_TASK__DISTRACTORS__MODEL=qwen3.5:4b
LLM_TASK__DISTRACTORS__PROMPT_VERSION=v1
# Opcionales: sin definir, no se envían y rige el valor por defecto del modelo.
# Qwen3.5 razona por defecto; en generación se desactiva (D-003).
LLM_TASK__DISTRACTORS__THINK=false
# LLM_TASK__DISTRACTORS__TEMPERATURE=0.7

# Ollama, nativo en WSL2 y fuera de compose (D-024). Sin OLLAMA_BASE_URL, los
# tests de integración con Ollama se saltan. El tiempo de espera es por
# petición, y su valor por defecto y la medición que lo justifica están en
# vocab/config.py.
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TIMEOUT_SECONDS=
